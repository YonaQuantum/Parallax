{
  "name": "parallax",
  "version": "0.1.0",
  "private": true,
  "description": "An open, self-hosted technical community centered on documents, media, discussions, world signals, and extensible community building.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @parallax/web",
    "build": "npm run db:generate && npm run build -w @parallax/web",
    "start": "npm run start -w @parallax/web",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "compose:config": "docker compose -f infra/docker/docker-compose.yml config",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml down",
    "radar:dry-run": "node --env-file=.env services/radar/runner.mjs --config services/radar/config.example.json --once --dry-run --include-disabled --limit 2",
    "radar:once": "node --env-file=.env services/radar/runner.mjs --config services/radar/config.local.json --once",
    "radar:run": "node --env-file=.env services/radar/runner.mjs --config services/radar/config.local.json",
    "radar:test": "node --test services/radar/tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "prisma": "6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
