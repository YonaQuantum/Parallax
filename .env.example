# App
APP_URL=http://localhost:3000
SITE_SERVICE_NAME=parallax-community
NEXT_PUBLIC_SITE_NAME=PARALLAX
NEXT_PUBLIC_SITE_LOCAL_NAME=异视社区
NEXT_PUBLIC_SITE_LOGO_TEXT=PX
NEXT_PUBLIC_SITE_LOCALE=zh-CN
NEXT_PUBLIC_SITE_DESCRIPTION=开源、自托管的综合技术社区，面向编程与开源、AI 与模型、游戏与交互、硬件与嵌入式、创作与媒体、科学与宇宙。
NEXT_PUBLIC_RADAR_NAME=PARALLAX Radar
NEXT_PUBLIC_SITE_ACCENT="#ffd400"
NEXT_PUBLIC_HALO_ASSET=
SEED_OWNER_EMAIL=owner@example.local
SEED_OWNER_HANDLE=owner
SEED_OWNER_NAME=Owner
SEED_OWNER_PASSWORD=change-me-before-public-deploy

# Database
POSTGRES_USER=parallax
POSTGRES_DB=parallax
POSTGRES_PASSWORD=parallax
DATABASE_URL=postgresql://parallax:parallax@localhost:5432/parallax?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Local object storage.
# First self-hosted version stores uploaded files on the host disk.
UPLOAD_DIR=./data/uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# Email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Radar bridge
# Generate a long random value before exposing the site to the public internet.
RADAR_SHARED_SECRET=
RADAR_CONFIG_PATH=./config/radars.local.json
PARALLAX_BASE_URL=http://127.0.0.1:3000
OPENAI_API_KEY=
GITHUB_TOKEN=

# S3-compatible storage, optional later.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parallax
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password
